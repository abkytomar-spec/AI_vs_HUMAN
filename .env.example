# Copy to .env.local and fill in to enable the Supabase backend.
# Leave empty to run in static mode (rounds and answers are bundled with the app).

# Which data source to use: "static" (default) or "supabase".
VITE_DATA_SOURCE=static

# Public project URL and anon key from Supabase → Project settings → API.
# The anon key is designed to be public; Row Level Security protects the data.
# Never put the service_role key in any VITE_ variable: it would ship to every browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
